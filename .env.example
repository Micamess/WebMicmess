# Copiá este archivo a ".env" y completá los valores.
# Los sacás del panel de tu proyecto en https://supabase.com
# Project Settings -> API Keys. VITE_SUPABASE_URL es el "Project URL" SIN /rest/v1/ al final.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: sin esto, la búsqueda automática de portadas queda desactivada
# y hay que cargar el juego a mano. Se consigue gratis en https://rawg.io/apidocs
VITE_RAWG_API_KEY=
